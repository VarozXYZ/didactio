NODE_ENV=production
PORT=3000
LOG_LEVEL=info

APP_PUBLIC_URL=https://your-domain.com

GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=https://your-domain.com/auth/google/callback

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
TRUST_PROXY=true
CORS_ALLOWED_ORIGINS=https://your-domain.com
AUTH_ALLOWED_REDIRECTS=https://your-domain.com,https://your-domain.com/dashboard,https://your-domain.com/auth/callback
AUTH_DEFAULT_REDIRECT=https://your-domain.com/dashboard
AUTH_ADMIN_EMAILS=

AI_GATEWAY_API_KEY=replace-me
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=didactio-production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=false

REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=didactio:ratelimit
API_RATE_LIMIT_PER_MINUTE=120
AI_CHEAP_PROVIDER=deepseek
AI_CHEAP_MODEL=deepseek-v4-flash
AI_PREMIUM_PROVIDER=deepseek
AI_PREMIUM_MODEL=deepseek-reasoner

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_PACK=
STRIPE_PRICE_CREATOR_PACK=
STRIPE_PRICE_TEACHER_MONTHLY=
STRIPE_PRICE_TEACHER_PRO_MONTHLY=
